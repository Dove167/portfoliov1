  <!-- Image Modal/Lightbox -->
  <div id="image-modal" class="fixed inset-0 bg-black/95 z-50 hidden items-center justify-center p-4" onclick="if(event.target === this) closeModal()">
    <button id="modal-close" class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white hover:text-tan-400 text-3xl font-bold bg-darkblue-500/50 rounded-full hover:bg-darkblue-500/80 transition-colors">&times;</button>
    <button id="modal-expand" class="absolute top-4 right-16 w-10 h-10 flex items-center justify-center text-white hover:text-tan-400 text-2xl bg-darkblue-500/50 rounded-full hover:bg-darkblue-500/80 transition-colors" title="Open full size">⛶</button>
    <img id="modal-image" src="" alt="" class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl" onclick="closeModal()" style="cursor: zoom-out;" />
    <p id="modal-caption" class="text-beige-300 text-center mt-4 text-lg"></p>
  </div>

  <script>
    function openModal(src, alt) {
      const modal = document.getElementById('image-modal');
      const modalImg = document.getElementById('modal-image');
      const caption = document.getElementById('modal-caption');
      const closeBtn = document.getElementById('modal-close');
      const expandBtn = document.getElementById('modal-expand');
      if (modal && modalImg) {
        modalImg.src = src;
        modalImg.alt = alt;
        if (caption) caption.textContent = alt;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        closeBtn.onclick = closeModal;
        expandBtn.onclick = () => window.open(src, '_blank');
        modalImg.onclick = closeModal;
      }
    }

    function closeModal() {
      const modal = document.getElementById('image-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    // Add click handlers to all case study images
    document.querySelectorAll('.case-study-img').forEach(img => {
      img.style.cursor = 'zoom-in';
      img.parentElement.style.position = 'relative';
      // Add expand icon overlay
      const icon = document.createElement('span');
      icon.innerHTML = '⛶';
      icon.className = 'expand-icon';
      icon.style.cssText = 'position: absolute; top: 8px; right: 8px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: rgba(26, 54, 93, 0.8); color: #e8dcc8; border-radius: 6px; font-size: 18px; opacity: 0; transition: opacity 0.2s; pointer-events: none;';
      img.parentElement.appendChild(icon);
      img.parentElement.onmouseenter = () => icon.style.opacity = '1';
      img.parentElement.onmouseleave = () => icon.style.opacity = '0';
      img.addEventListener('click', () => {
        openModal(img.src, img.alt);
      });
    });

    // Close modal on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
